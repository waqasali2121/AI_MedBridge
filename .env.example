# MedBridge Environment Configuration
# Copy this to .env to connect to your live Supabase project
# If left blank or missing, MedBridge runs automatically in Zero-Config Demo Mode with local state

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Storage configuration
VITE_SUPABASE_STORAGE_BUCKET=prescriptions

# Maximum upload file size in megabytes (Default: 10MB)
VITE_MAX_UPLOAD_SIZE_MB=10
